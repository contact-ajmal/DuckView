{
  "name": "@duckview/server",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "duckview": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/cli.ts serve",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate:sqlite": "drizzle-kit generate --config drizzle.config.sqlite.ts",
    "db:generate:pg": "drizzle-kit generate --config drizzle.config.pg.ts",
    "db:generate": "pnpm db:generate:sqlite && pnpm db:generate:pg"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@aws-sdk/client-bedrock": "^3.1134.0",
    "@aws-sdk/client-bedrock-agent": "^3.1134.0",
    "@aws-sdk/client-bedrock-agent-runtime": "^3.1134.0",
    "@aws-sdk/client-bedrock-agentcore": "^3.1134.0",
    "@aws-sdk/client-bedrock-agentcore-control": "^3.1134.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1134.0",
    "@aws-sdk/client-s3": "^3.1134.0",
    "@aws-sdk/lib-storage": "^3.1136.0",
    "@azure/storage-blob": "^12.33.0",
    "@duckdb/node-api": "1.5.5-r.5",
    "@fastify/cors": "^11.0.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^8.0.0",
    "@fastify/websocket": "^11.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.203.0",
    "@opentelemetry/resources": "^2.0.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "@opentelemetry/sdk-trace-node": "^2.0.0",
    "@opentelemetry/semantic-conventions": "^1.36.0",
    "@uwdata/mosaic-sql": "0.31.0",
    "apache-arrow": "^18.1.0",
    "better-sqlite3": "^12.0.0",
    "commander": "^14.0.0",
    "cron-parser": "^4.9.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.5",
    "fastify-plugin": "^5.1.0",
    "node-sql-parser": "^5.3.0",
    "openai": "^7.17.0",
    "openid-client": "^6.0.0",
    "pg": "^8.16.0",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.0",
    "yaml": "^2.9.1",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/ws": "^8.18.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "ws": "^8.21.3"
  }
}
